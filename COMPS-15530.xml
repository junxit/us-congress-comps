                </paragraph>
                <paragraph style="-uslm-dtd:paragraph" identifier="/us/sComp/116/74/s2/a/2" styleType="OLC">
                    <num style="-uslm-dtd:enum" value="2">(2) </num><editorialNote style="-uslm-dtd:usc-reference" role="uscRef"><b>[</b><ref href="/us/usc/t21/s1702">21 U.S.C. 1702</ref><b>]</b> </editorialNote><content style="-uslm-dtd:text">by striking “<quotedText style="-uslm-dtd:quote">National Drug Control Program Agencies</quotedText>” and inserting “<quotedText style="-uslm-dtd:quote">National Drug Control Program agencies</quotedText>” each place it appears; </content>
