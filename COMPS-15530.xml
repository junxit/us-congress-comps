    <main style="-uslm-dtd:legis-body"><longTitle><docTitle style="-uslm-dtd:legis-type">AN ACT</docTitle><officialTitle style="-uslm-dtd:official-title">To amend the Office of National Drug Control Policy Reauthorization Act of 1998 to make technical corrections.</officialTitle></longTitle><enactingFormula style="-uslm-dtd:enacting-clause">Be it enacted by the Senate and House of Representatives of the United States of America in Congress assembled,</enactingFormula>
        <section style="-uslm-dtd:section" identifier="/us/sComp/116/74/s1" styleType="OLC">
            <num style="-uslm-dtd:enum" value="1">SECTION 1. </num><editorialNote style="-uslm-dtd:usc-reference" role="uscRef"><b>[</b><ref href="/us/usc/t21/s1701">21 U.S.C. 1701 note</ref><b>]</b> </editorialNote><heading style="-uslm-dtd:header">SHORT TITLE. </heading>
            <content style="-uslm-dtd:text" class="block">  This Act may be cited as the “<shortTitle style="-uslm-dtd:quote">ONDCP Technical Corrections Act of 2019</shortTitle>”. </content>
        </section>
        <section style="-uslm-dtd:section" identifier="/us/sComp/116/74/s2" styleType="OLC">
            <num style="-uslm-dtd:enum" value="2">SEC. 2. </num><heading style="-uslm-dtd:header">TECHNICAL CORRECTIONS. </heading>
            <subsection style="-uslm-dtd:subsection" identifier="/us/sComp/116/74/s2/a" styleType="OLC">
                <num style="-uslm-dtd:enum" value="a">(a) </num><heading style="-uslm-dtd:header">Office of National Drug Control Policy Reauthorization Act of 1998 Technical Corrections.—</heading><chapeau style="-uslm-dtd:text">The Office of National Drug Control Policy Reauthorization Act of 1998 (21 U.S.C. 1701 et seq.) is amended— </chapeau>
