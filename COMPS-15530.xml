                    <num style="-uslm-dtd:enum" value="3">(3) </num><content style="-uslm-dtd:text">in section 702(15), by striking “<quotedText style="-uslm-dtd:quote">tribal</quotedText>” each place it appears and inserting “<quotedText style="-uslm-dtd:quote">Tribal</quotedText>”; </content>
