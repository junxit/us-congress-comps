        <title style="-uslm-dtd:title; -uslm-dtd-nonstandard:all-cap 10 bold" identifier="/us/sComp/102/228/tII" styleType="nonstandard">
            <num style="-uslm-dtd:enum" value="II">TITLE II—</num><heading style="-uslm-dtd:header">SOVIET WEAPONS DESTRUCTION </heading>
            <part style="-uslm-dtd:part; -uslm-dtd-nonstandard:all-cap 10 bold" identifier="/us/sComp/102/228/tII/ptA" styleType="nonstandard">
                <num style="-uslm-dtd:enum" value="A">PART A—</num><heading style="-uslm-dtd:header">SHORT TITLE </heading>
                <section style="-uslm-dtd:section" identifier="/us/sComp/102/228/tII/ptA/s201" styleType="OLC">
                    <num style="-uslm-dtd:enum" value="201">SEC. 201. </num><editorialNote style="-uslm-dtd:usc-reference" role="uscRef"><b>[</b><ref href="/us/usc/t22/s2551">22 U.S.C. 2551 note</ref><b>]</b> </editorialNote><heading style="-uslm-dtd:header">SHORT TITLE. </heading>
                    <content style="-uslm-dtd:text" class="block">This title may be cited as the “<shortTitle style="-uslm-dtd:quote"><inline style="-uslm-dtd:short-title">Soviet Nuclear Threat Reduction Act of 1991</inline></shortTitle>”.</content>
                </section>
            </part>
            <part style="-uslm-dtd:part; -uslm-dtd-nonstandard:all-cap 10 bold" identifier="/us/sComp/102/228/tII/ptB" styleType="nonstandard">
