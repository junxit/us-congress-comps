        <property role="compShortTitle" style="-uslm-dtd:comp-short-title">Don Young Recognition Act</property>
        <citationNote style="-uslm-dtd:public-law">[(<citableAs>Public Law 117–358</citableAs>)]</citationNote>
        <editionNote style="-uslm-dtd:updated-through-note">[This law has not been amended]</editionNote>
